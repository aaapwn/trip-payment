# MongoDB Connection
# ⚠️  ถ้าไม่ตั้งค่า MONGODB_URI ระบบจะใช้ mock data (ข้อมูลจะหายเมื่อรีสตาร์ท)
# 
# Option 1: MongoDB Local (แนะนำสำหรับ dev)
MONGODB_URI=mongodb://localhost:27017/trip-payment
# 
# Option 2: MongoDB Atlas (Free cloud database)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trip-payment?retryWrites=true&w=majority
# 
# Option 3: ทดสอบโดยไม่มี Database - Comment บรรทัด MONGODB_URI ด้านบนออก
# (ข้อมูลจะเป็น mock data และหายเมื่อรีสตาร์ท server)
